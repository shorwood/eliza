{
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.direnv",
    "**/node_modules",
    "**/target",
    "**/dist",
    "**/storybook-static",
  ],
  "lsp": {
    "cucumber": {
      "settings": {
        "features": [
          "e2e/features/**/*.feature"
        ],
        "glue": [
          "e2e/src/steps/**/*.rs"
        ]
      }
    },
    "rust-analyzer": {
      "initialization_options": {
        "cargo": {
          "allTargets": false,
          "targetDir": ".direnv/rust-analyzer-target"
        },
        "cachePriming": {
          "enable": false
        },
        "cfg": {
          "setTest": false
        },
        "check": {
          "allTargets": false,
          "workspace": false
        },
        "checkOnSave": false,
        "files": {
          "exclude": [
            ".direnv",
            "target",
          ]
        },
        "lru": {
          "capacity": 32
        },
        "numThreads": 2,
        "rust": {
          "analyzerTargetDir": ".direnv/rust-analyzer-target"
        }
      }
    }
  },
}
